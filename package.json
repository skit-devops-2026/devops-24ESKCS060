{
  "name": "devops-weather-dashboard",
  "version": "1.0.0",
  "description": "Full-stack DevOps Weather Dashboard with CI/CD, Containerization, Prometheus Monitoring & Kubernetes Deployment",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node src/app.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "devops",
    "weather-dashboard",
    "prometheus",
    "kubernetes",
    "docker",
    "ci-cd"
  ],
  "author": "DevOps Student",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "./coverage",
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  }
}
